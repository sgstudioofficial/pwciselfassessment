# Used by `supabase functions serve --env-file supabase/functions/.env`.
# For hosted projects, set these with `supabase secrets set ...` instead.
# Never commit the real file: supabase/functions/.env is gitignored.

# Recommended: restrict Edge Function CORS to your app origin.
ALLOWED_ORIGIN=http://localhost:5173

# Domain used to construct internal Auth emails for students.
# Use a real domain you control; students sign in with their username.
STUDENT_EMAIL_DOMAIN=students.example.com

# Required only by notify-submission. Generate with:
#   openssl rand -hex 32
NOTIFY_WEBHOOK_SECRET=replace-with-a-long-random-secret

# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# automatically by the Supabase CLI and hosted runtime. Never put them here.
