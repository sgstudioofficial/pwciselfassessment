# ---------------------------------------------------------------------------
# Frontend (bundled into the browser; safe to expose, protected by RLS)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Address printed in the student sign-in message. Defaults to the
# current origin, or the hosted site when the admin is on localhost.
# VITE_PUBLIC_SITE_URL=https://pwciselfassessment.vercel.app

# ---------------------------------------------------------------------------
# Server-only values used by `npm run create-admin`.
# NEVER prefix these with VITE_ and never commit .env.local.
# The service-role key bypasses Row Level Security.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
